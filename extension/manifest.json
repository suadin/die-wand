{
  "manifest_version": 3,
  "name": "die-wand",
  "version": "1.4.1",
  "description": "Verwaltet die Lesezeichen der die-wand-Startseite direkt in Chrome.",
  "permissions": ["bookmarks", "favicon", "tabs"],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": [
        "http://127.0.0.1:8080/*",
        "http://localhost:8080/*",
        "https://192.168.178.50:8443/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "die-wand",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:8080/*",
      "http://localhost:8080/*",
      "https://192.168.178.50:8443/*"
    ]
  },
  "key": ""
}
