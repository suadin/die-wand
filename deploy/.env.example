# Nach deploy/.env kopieren und anpassen. Die Datei ist gitignored: sie nennt
# diese Maschine und wird nie committet.

# Ziel-NAS (dieselben Werte wie in ~/Projects/mcps/ssh-mcp/.env unter
# SSH_TARGETS → "nas").
NAS_HOST=<nas-ip>
NAS_USER=<ssh-user>
NAS_KEY=$HOME/.ssh/<key-name>
NAS_DIR=/volume1/docker/die-wand

# Optional: Pfad zur lokalen Zertifizierungsstelle (Zertifikate für alle Apps).
# TLS_DIR=$HOME/Projects/tls
